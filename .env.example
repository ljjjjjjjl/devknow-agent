# 复制成 .env 再填。真 key 绝不提交（.env 已在 .gitignore 里）。
# 字段不区分必填/可选：留空的都有默认值，只有 key 必须自己填。

# ---- SiliconFlow：chat / embedding / rerank 共用这一个 key ----
SILICONFLOW_API_KEY=

# ---- PostgreSQL（本项目自己的库，由 app.ingest 灌数据）----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=devknow_py
DB_USER=devknow
DB_PASSWORD=

# ---- 检索 ----
# 关掉精排可省一次 API 调用，用于对比实验；线上默认开
RERANK_ENABLED=true

# ---- 采集（只有 sync-issues / sync-docs 用得到，服务启动不读）----
# 不填也能跑，但 GitHub 匿名限流 60 次/小时，全量同步会卡死
GITHUB_TOKEN=
